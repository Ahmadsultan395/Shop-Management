{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:3000",
    "distDir": "../src-tauri/dist-placeholder"
  },
  "package": {
    "productName": "Shop Manager",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "sidecar": true,
        "scope": [
          {
            "name": "binaries/node",
            "sidecar": true,
            "args": true
          }
        ]
      }
    },
    "bundle": {
      "active": true,
      "identifier": "com.shopmanager.desktop",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "targets": ["nsis"],
      "externalBin": ["binaries/node"],
      "resources": {
        "resources/server/**/*": "server/"
      },
      "windows": {
        "nsis": {
          "installMode": "perMachine",
          "languages": ["English"]
        }
      }
    },
    "security": {
      "csp": null
    },
    "windows": [],
    "systemTray": null
  }
}
